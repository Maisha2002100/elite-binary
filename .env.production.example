PORT=3000
ADMIN_KEY=change-this-admin-key
JWT_SECRET=change-this-jwt-secret-please

# Supabase Postgres persistence. Without this, Vercel's /tmp db is ephemeral.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_TABLE=app_state
SUPABASE_DB_ID=elite-binary

MOCK_PAYMENTS=false
PAYMENT_PROVIDER=payhero
PAYHERO_BASIC_AUTH=your-payhero-basic-auth-token
PAYHERO_CHANNEL_ID=8005
PAYHERO_PROVIDER=m-pesa
PAYHERO_CALLBACK_URL=https://your-domain.com/api/payhero/callback

MPESA_ENV=sandbox
MPESA_BASIC_AUTH=your-base64-basic-auth
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret


MPESA_CHANNEL_ID=
MPESA_SHORTCODE=
MPESA_PASSKEY=your-stk-passkey
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/stk-callback

MPESA_B2C_SHORTCODE=your-b2c-shortcode
MPESA_B2C_INITIATOR_NAME=your-initiator
MPESA_B2C_SECURITY_CREDENTIAL=your-security-credential
MPESA_B2C_RESULT_URL=https://your-domain.com/api/mpesa/b2c-result
